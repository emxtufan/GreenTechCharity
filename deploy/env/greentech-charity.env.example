# Copiaza acest sablon in /etc/greentech-charity/greentech-charity.env.
# Nu introduce valori reale in Git. Fisierul de productie trebuie sa aiba modul 0640.

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
SUBMISSION_HASH_SECRET=

# Director persistent, scriibil numai de utilizatorul serviciului systemd.
SUBMISSIONS_FILE=/var/lib/greentech-charity/form-submissions.json

# Gmail SMTP: foloseste o Google App Password. Daca portul 25 este blocat de
# providerul VPS, foloseste 587 cu aceleasi optiuni STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=aigreentech1@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=GREENTECH Charity
SMTP_FROM_EMAIL=aigreentech1@gmail.com
SMTP_TO=aigreentech1@gmail.com
SMTP_CONNECTION_TIMEOUT_MS=12000
