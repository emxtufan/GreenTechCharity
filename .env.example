# Copiaza acest sablon in .env pentru /admin/. Nu publica fisierul .env real.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Secrete diferite, aleatoare, cu minimum 32 de caractere fiecare.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
SUBMISSION_HASH_SECRET=replace-with-another-32-random-characters

# Fisier privat, in afara directoarelor public/ si dist/.
SUBMISSIONS_FILE=storage/form-submissions.json

# Gmail SMTP. Foloseste o Google App Password, nu parola obisnuita a contului.
# Portul 25 este configurat conform infrastructurii solicitate. Daca VPS-ul il
# blocheaza, schimba SMTP_PORT la 587; SMTP_SECURE ramane false pentru STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=aigreentech1@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=GREENTECH Charity
SMTP_FROM_EMAIL=aigreentech1@gmail.com
SMTP_TO=aigreentech1@gmail.com
SMTP_CONNECTION_TIMEOUT_MS=12000

PORT=3000
HOST=0.0.0.0

# Optional: muta modelul original pe un CDN/R2 propriu. CDN-ul trebuie sa
# permita CORS, GET/HEAD si Range requests. Acelasi model compact este folosit
# pe desktop si mobil; rendererul original gestioneaza automat DPR-ul (max. 2)
# si OffscreenCanvas, fara un profil vizual degradat pentru telefon.
VITE_SCENE_MODEL_URL=/greencube-original-OE4BBULY.glb
