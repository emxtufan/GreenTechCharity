# Dependencies and package-manager caches
node_modules/
.npm/
.yarn/
.pnpm-store/
.bun/

# Local environment and secrets
.env
.env.*
!.env.example

# Generated builds, tests and tool caches
dist/
build/
coverage/
.vite/
.cache/
*.tsbuildinfo

# Runtime data submitted through the website
storage/*
!storage/.gitkeep

# Deployment archives and local backups
zip/
*.zip
*.zip.sha256
RELEASE-MANIFEST.json
RELEASE-SHA256SUMS.txt

# Keep only the GLB used by the current runtime
public/*.glb
!public/greencube-original-OE4BBULY.glb
public/*.glb2

# Logs and temporary files
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
